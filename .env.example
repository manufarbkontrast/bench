# Where Bench finds what it reads. Copy to .env and fill in - .env is gitignored.
# A missing or blank key means "not configured"; the app that needs it then uses its bundled sample.
# More keys arrive with the apps that read them (Plaud, controlling, inbox).
VAULT_DIR=/Users/you/path/to/your-obsidian-vault

# Colon-separated roots the Projekte app scans for git checkouts, e.g. ~/Downloads:~/Projects
PROJECT_ROOTS=

# The Plaud folder; Bench reads processed notes from <PLAUD_HOME>/notizen, e.g. ~/Plaud
PLAUD_HOME=

# Colon-separated folders the Eingang app watches for new material, e.g. ~/Downloads:~/Plaud/inbox
INBOX_WATCH=
# Where the controlling runs write their reports, e.g. ~/Downloads/shoesplease-controlling
CONTROLLING_DIR=
